[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/stall_card.gd" id="1_card"]

[node name="StallCard" type="PanelContainer"]
texture_filter = 1
custom_minimum_size = Vector2(150, 0)
mouse_filter = 1
theme_type_variation = &"ShopRow"
script = ExtResource("1_card")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 2
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 2

[node name="V" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 1

[node name="CardIcon" type="TextureRect" parent="Margin/V"]
unique_name_in_owner = true
texture_filter = 1
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="CardName" type="Label" parent="Margin/V"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
horizontal_alignment = 1
clip_text = true
text_overrun_behavior = 3

[node name="CardInfo" type="Label" parent="Margin/V"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.72, 0.6, 1)
theme_override_font_sizes/font_size = 18
horizontal_alignment = 1
clip_text = true

[node name="Buttons" type="HBoxContainer" parent="Margin/V"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="CardOneButton" type="Button" parent="Margin/V/Buttons"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(36, 38)
layout_mode = 2
mouse_filter = 1
focus_mode = 0
theme_override_font_sizes/font_size = 18
text = "1"

[node name="CardButton" type="Button" parent="Margin/V/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 1
focus_mode = 0
theme_type_variation = &"AccentButton"
theme_override_font_sizes/font_size = 18
text = "€0"
